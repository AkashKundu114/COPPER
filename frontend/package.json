{
  "name": "frontend",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "COPPER - Cognitive Offline Personal Partner & Epistemic Reasoner",
  "author": "Akash Kundu <akashkundu1152@gmail.com>",
  "homepage": "https://github.com/AkashKundu114/COPPER",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently \"npm run dev\" \"wait-on tcp:5173 && node launch-desktop.js\"",
    "desktop:electron": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "desktop:build": "npm run build && electron-builder",
    "desktop:build:win": "npm run build && electron-builder --win",
    "desktop:build:mac": "npm run build && electron-builder --mac",
    "desktop:build:linux": "npm run build && electron-builder --linux",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "framer-motion": "^13.5.1",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.copper.ai",
    "productName": "COPPER",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Akash Kundu <akashkundu1152@gmail.com>"
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

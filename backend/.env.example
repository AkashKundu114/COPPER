# === COPPER Environment Config ===

# App
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=false

# Database
POSTGRES_USER=copper
POSTGRES_PASSWORD=copperpass
POSTGRES_DB=copperdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3

# OpenAI (optional; leave blank to use Ollama only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Voice
WHISPER_MODEL=base
TTS_MODEL=tts-1
TTS_VOICE=alloy
WAKE_WORD=copper

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1

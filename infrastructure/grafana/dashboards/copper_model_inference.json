      },
      "id": 1,
      "title": "Tokens Per Second",
      "type": "gauge",
      "targets": [
        {
          "expr": "copper_llm_tokens_per_second",
          "legendFormat": "{{model_name}}"
        }
      ]
    },
    {
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Inference Queue Depth",
      "type": "stat",
      "targets": [
        {
          "expr": "copper_inference_queue_depth",
          "legendFormat": "Queued Tasks"
        }
      ]
    },
    {
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "title": "Total Tokens Generated",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(copper_llm_tokens_generated_total)",
          "legendFormat": "Tokens Out"
        }
      ]
    },
    {
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "title": "Model Load Duration (sec)",
      "type": "stat",
      "targets": [
        {
          "expr": "copper_model_loading_seconds",
          "legendFormat": "{{model_name}}"
        }
      ]
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "title": "Model Inference Duration (p50, p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(copper_llm_inference_duration_seconds_bucket[5m])) by (le, model_name))",
          "legendFormat": "p50: {{model_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(copper_llm_inference_duration_seconds_bucket[5m])) by (le, model_name))",
          "legendFormat": "p95: {{model_name}}"
        }
      ]
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "title": "Token Generation Rate by Model",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(copper_llm_tokens_generated_total[1m])) by (model_name)",
          "legendFormat": "{{model_name}}"
        }
      ]
    }

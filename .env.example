# ==============================================================================
# COPPER Configuration Environment Template (.env.example)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Metadata
APP_NAME=COPPER
APP_VERSION=3.0.0
APP_ENV=development

# Allowed CORS Origins (JSON list or comma-separated string)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","tauri://localhost","http://tauri.localhost"]

# Database & Cache Locations
# Default uses local SQLite with Write-Ahead Logging (WAL)
DATABASE_URL=sqlite:///data/copper_memory.db
REDIS_URL=redis://localhost:6379/0

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
GATEKEEPER_KEEP_ALIVE=-1
HEAVY_MODEL_IDLE_UNLOAD_SECONDS=240

# Local Storage & Asset Directories
DOCUMENTS_DIR=data/documents
IMAGE_OUTPUT_DIR=frontend/public/generated

# Voice & Wake-Word Pipeline
WAKE_WORD_ENGINE=openwakeword
TTS_ENGINE=auto
TTS_OFFLINE_ONLY=true

# Local Image Diffusion Generation
IMAGE_DEVICE=auto
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_INFERENCE_STEPS=1
IMAGE_OFFLINE_ONLY=true

# Search Engine (Local SearXNG instance)
SEARXNG_URL=http://localhost:8888
WEB_SEARCH_ENABLED=true

# Code Execution Sandbox
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_ENABLED=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim

# Observability & OpenTelemetry (Disabled by default for 100% air-gap integrity)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=copper-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_URL=http://localhost:3000

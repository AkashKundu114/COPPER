*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/*
!backend/data/agency_agents_full_catalog.json
!backend/data/scientific_skills_catalog.json
postgres-data/
redis-data/
dump.rdb


# ==============================================================================
# COPPER — Root .gitignore
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
secrets.yaml
credentials.json
service-account*.json

# ── Local Databases & Persistence ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/
postgres-data/
redis-data/
dump.rdb

# ── Runtime Data (user-generated, never committed) ────────────────────────────
data/audio/
data/conversations/
data/logs/
data/memory/
data/reminders/
data/screenshots/
data/vector/
data/user_profile.json

# ── Model Binaries & Quantized Weights ────────────────────────────────────────
ai-models/
!ai-models/models_manifest.json
/models/
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.h5

# ── Vector / Embedding Stores ─────────────────────────────────────────────────
chromadb/
chromadb_data/
*.parquet

# ── Python Caches & Build ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.lcov
.nyc_output/

# ── Benchmark / Eval Outputs ──────────────────────────────────────────────────
backend/eval/benchmark_metrics.json
backend/eval/benchmark_report.md
backend/eval/datasets/

# ── Node & Frontend Build ─────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/dist-electron/
.npm
.eslintcache
.stylelintcache
.oxlintcache
.vite/
frontend/.vite/
*.tsbuildinfo

# ── Electron Builder Output ───────────────────────────────────────────────────
frontend/dist-electron/

# ── Tauri Build Target ────────────────────────────────────────────────────────
src-tauri/target/

# ── Sandboxes & Temp ──────────────────────────────────────────────────────────
sandbox/
backend/sandbox/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
scratch/
.tmp/

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
